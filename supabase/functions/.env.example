# Secrets for Supabase Edge Functions. For local runs copy to supabase/functions/.env
# (gitignored) and use: supabase functions serve --env-file supabase/functions/.env
# In production set them with: supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically; don't add them here.

# Involve Asia → Profile → Tools → API (shown after your key request is approved)
INVOLVE_ASIA_API_KEY=your-involve-asia-api-key
INVOLVE_ASIA_API_SECRET=your-involve-asia-api-secret

# Any long random string (e.g. `openssl rand -hex 32`). The pg_cron job sends it in the
# x-cron-secret header so only the scheduler can trigger the collector.
COLLECTOR_CRON_SECRET=change-me-to-a-long-random-string

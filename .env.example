# Copy this file to .env and fill in your Supabase project values.
# Find them in Supabase → Project Settings → API.
# The publishable key is safe for the browser; NEVER put the secret/service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-side secrets for the deal collectors (Supabase Edge Functions) do NOT go here,
# because this file feeds the browser build. See supabase/functions/.env.example:
#   INVOLVE_ASIA_API_KEY, INVOLVE_ASIA_API_SECRET, COLLECTOR_CRON_SECRET
